# Convex (dev deployment URL; convex deploy injects it on Vercel)
CONVEX_URL=

# Shared secret for Convex service mutations (must match Convex env SERVICE_KEY)
SERVICE_KEY=

# Absolute site URL (used for payment redirects)
APP_URL=http://localhost:3000

# Stripe (also used by the online courses: card checkout; the webhook must send
# checkout.session.completed). Convex needs APP_URL, RESEND_API_KEY and SERVICE_KEY
# in its own environment for the purchase and sign-in emails.
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenNode (BTC donations)
OPENNODE_API_KEY=

# Substack silent-subscribe base URL (optional)
SUBSTACK_URL=

# WhatsApp community invite for the free Layer 0 button (optional override;
# defaults to the official IPB community link).
COMMUNITY_URL=
