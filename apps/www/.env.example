# Convex (dev deployment URL; convex deploy injects it on Vercel)
CONVEX_URL=

# Shared secret for Convex service mutations (must match Convex env SERVICE_KEY)
SERVICE_KEY=

# Absolute site URL (used for payment redirects)
APP_URL=http://localhost:3000

# Stripe
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenNode (BTC donations)
OPENNODE_API_KEY=


# WhatsApp community invite for the free Layer 0 button (optional override;
# defaults to the official IPB community link).
COMMUNITY_URL=

# Newsletter: Resend webhook signing secret. In Resend, create a webhook for the
# `contact.updated` event pointing at <site>/api/resend-webhook so unsubscribes
# reach Convex. (RESEND_API_KEY / RESEND_SEGMENT_ID live in the Convex env.)
RESEND_WEBHOOK_SECRET=
